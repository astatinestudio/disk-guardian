[Unit]
Description=Disk Guardian collector (SMART / NVMe / SAS / temperature / btrfs)
Documentation=https://github.com/astatinestudio/disk-guardian
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/disk-guardian --service
Restart=on-failure
RestartSec=5
RuntimeDirectory=diskguardian
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
StateDirectory=diskguardian
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
